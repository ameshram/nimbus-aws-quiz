# Copy to .env and fill in. Only ANTHROPIC_API_KEY is needed to run the admin
# content-generation/validation tools; the quiz/flashcard study modes serve the
# committed banks in public/ without any of these set.

# Anthropic Claude API key — required for the admin content pipeline only.
ANTHROPIC_API_KEY=sk-ant-...

# HTTP server
PORT=3001
NODE_ENV=development

# PostgreSQL (Sequelize) — required for progress tracking / accounts.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nimbus
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
